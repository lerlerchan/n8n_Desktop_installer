{
  "name": "n8n-desktop",
  "version": "1.0.0",
  "description": "n8n Desktop Application - Run n8n locally with a system tray interface",
  "main": "main/index.js",
  "author": "n8n Desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ELECTRON_DEV_MODE=true electron .",
    "build:win": "electron-builder build --win --x64 --publish never",
    "build:mac": "electron-builder build --mac --publish never",
    "build:mac:unsigned": "electron-builder build --mac -c.mac.identity=null --publish never",
    "build:runtime": "node scripts/build-runtime.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "io.n8n.desktop",
    "productName": "n8n Desktop",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/n8n/**/*",
      "!node_modules/sqlite3/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.9",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "find-process": "^1.4.7",
    "node-fetch": "^2.7.0",
    "respawn": "^2.6.0",
    "tcp-port-used": "^1.0.2"
  },
  "optionalDependencies": {},
  "n8nRuntimeDependencies": {
    "_comment": "These are installed in the separate runtime package, not bundled with Electron",
    "n8n": "^1.70.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
